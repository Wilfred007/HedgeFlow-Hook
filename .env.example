# ─── Blockchain (origin chain) ────────────────────────────────────────────────
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
ORIGIN_CHAIN_ID=84532            # used by DeployReactive.s.sol
START_BLOCK=0

# ─── Contract Addresses (set after Deploy.s.sol) ──────────────────────────────
HEDGEFLOW_HOOK=0x
RISK_MANAGER=0x
RESERVE_VAULT=0x
ORACLE_MANAGER=0x
FEE_ROUTER=0x

# ─── Reactive Network ─────────────────────────────────────────────────────────
# Deploy target: https://dev.reactive.network/reactive-smart-contracts/getting-started
REACTIVE_NETWORK_RPC_URL=https://kopli-rpc.rkt.ink
HEDGEFLOW_REACTIVE=0x            # set after running scripts/DeployReactive.s.sol
# After deploying, fund the RSC with native token for subscription gas:
#   cast send $HEDGEFLOW_REACTIVE --value 0.1ether \
#     --rpc-url $REACTIVE_NETWORK_RPC_URL --private-key $DEPLOYER_PRIVATE_KEY

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hedgeflow:hedgeflow@localhost:5432/hedgeflow

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Risk Engine ───────────────────────────────────────────────────────────────
RISK_ENGINE_URL=http://localhost:8000
RISK_ENGINE_PORT=8000

# ─── Automation ────────────────────────────────────────────────────────────────
AUTOMATION_PRIVATE_KEY=0x   # private key of the automation wallet
AUTOMATION_INTERVAL_MS=60000

# ─── API ───────────────────────────────────────────────────────────────────────
API_PORT=3001

# ─── HedgeFlow / xAI (optional — enables sentiment layer) ──────────────────────────
HedgeFlow_API_KEY=
HedgeFlow_API_URL=https://api.x.ai/v1

# ─── Frontend (Next.js public vars) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id
NEXT_PUBLIC_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
NEXT_PUBLIC_RPC_URL_ARB_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_DEMO_POOL_ID=0xdemo
